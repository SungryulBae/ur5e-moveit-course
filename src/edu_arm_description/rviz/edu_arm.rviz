Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Alpha: 0.8
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.3
      Frames:
        All Enabled: false
        base_link:
          Value: true
        tool0:
          Value: true
        tcp:
          Value: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: MarkerArray
      Enabled: true
      Topic:
        Value: /day1_markers
      Value: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.2
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.3
      Pitch: 0.45
      Yaw: 0.8
Window Geometry:
  Width: 1200
  Height: 800
